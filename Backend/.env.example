# Database: provide DATABASE_URL or the DB_* fields below.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gmail_attention
DB_USER=postgres
DB_PASSWORD=

# Register GOOGLE_REDIRECT_URI in the Google Cloud OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
FRONTEND_URL=http://localhost:5173

# Generate a unique value with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_SECURE=false

# Optional Gemini classification and concurrency settings.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GMAIL_DETAIL_WORKERS=6
GMAIL_ANALYSIS_WORKERS=4